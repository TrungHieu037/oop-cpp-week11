// =================================================================
// 1. CẤU TRÚC DATE (Quản lý Ngày/Tháng/Năm/Giờ/Phút/Giây)
// =================================================================
struct Date {
    int day;
    int month;
    int year;
    int hour;
    int minute;
    int second;

    // Constructor mặc định & tham số
    Date(int y = 2000, int m = 1, int d = 1, int h = 0, int min = 0, int s = 0)
        : year(y), month(m), day(d), hour(h), minute(min), second(s) {}

    // Định dạng ngày giờ dạng chuỗi: yyyy/mm/dd hh:mm:ss
    string toString() const {
        char buffer[30];
        snprintf(buffer, sizeof(buffer), "%04d/%02d/%02d %02d:%02d:%02d", 
                 year, month, day, hour, minute, second);
        return string(buffer);
    }

    // Định dạng ngắn gọn chỉ có ngày: dd/mm/yyyy
    string toShortDateString() const {
        char buffer[15];
        snprintf(buffer, sizeof(buffer), "%02d/%02d/%04d", day, month, year);
        return string(buffer);
    }
};

// =================================================================
// 2. CLASS STUDENT (Đóng gói Thuộc tính & Phương thức)
// =================================================================
class Student {
private:
    // Properties (Tính chất đóng gói - Data Hiding)
    string name;
    string address;
    Date birthdate;
    string cccd;

public:
    // --- CONSTRUCTORS (Hàm khởi tạo) ---
    // 1. Constructor mặc định
    Student() : name(""), address(""), birthdate(Date()), cccd("") {}

    // 2. Constructor khởi tạo Tên
    Student(string n) : name(n), address(""), birthdate(Date()), cccd("") {}

    // 3. Constructor khởi tạo Ngày sinh
    Student(Date d) : name(""), address(""), birthdate(d), cccd("") {}

    // 4. Constructor khởi tạo Tên và Địa chỉ
    Student(string name, string address) 
        : name(name), address(address), birthdate(Date()), cccd("") {}

    // 5. Constructor khởi tạo Tên, Địa chỉ và Ngày sinh
    Student(string name, string address, Date birthdate) 
        : name(name), address(address), birthdate(birthdate), cccd("") {}

    // 6. Constructor đầy đủ tất cả thuộc tính
    Student(string name, string address, Date birthdate, string cccd) 
        : name(name), address(address), birthdate(birthdate), cccd(cccd) {}

    // --- GETTERS & SETTERS (Các hàm truy xuất thuộc tính) ---
    string getName() const { return name; }
    string getAddress() const { return address; }
    Date getBirthdate() const { return birthdate; }
    string getCccd() const { return cccd; }

    void setName(string n) { name = n; }
    void setAddress(string addr) { address = addr; }
    void setBirthdate(Date d) { birthdate = d; }
    void setCccd(string c) { cccd = c; }

    // --- PHƯƠNG THỨC NHẬP / XUẤT THÔNG TIN ---
    // Nhập dữ liệu sinh viên từ bàn phím
    void setStudentInfo() {
        cout << "Nhap ho ten sinh vien: ";
        getline(cin >> ws, name);
        cout << "Nhap dia chi (VD: Vo Van Ngan, TpHCM): ";
        getline(cin, address);
        cout << "Nhap So CCCD: ";
        getline(cin, cccd);
        cout << "Nhap Ngay, Thang, Nam sinh (cach nhau bang dau cach): ";
        cin >> birthdate.day >> birthdate.month >> birthdate.year;
    }

    // Hiển thị thông tin sinh viên dưới dạng bảng
    void printStudentInfo() const {
        cout << left 
             << setw(22) << (name.empty() ? "(Chua co)" : name)
