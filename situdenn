};

// =================================================================
// 3. CÁC HÀM XỬ LÝ DANH SÁCH (TẤT CẢ TRẢ VỀ VECTOR<STUDENT>)
// =================================================================

// 1. Lấy thông tin sinh viên theo mã CCCD
// Trả về vector chứa 1 sinh viên tìm thấy (hoặc vector rỗng nếu không thấy)
vector<Student> getStudentInfoByCCCD(string cccd, const vector<Student>& list) {
    vector<Student> result;
    for (size_t i = 0; i < list.size(); i++) {
        if (list[i].getCccd() == cccd) {
            result.push_back(list[i]);
            break; // CCCD là duy nhất nên thoát vòng lặp ngay khi tìm thấy
        }
    }
    return result;
}

// 2. Tìm kiếm sinh viên theo Tên (Tìm kiếm gần đúng)
vector<Student> getStudentsByName(string name, const vector<Student>& list) {
    vector<Student> result;
    for (const auto& student : list) {
        // So sánh chuỗi không phân biệt hoa thường hoặc chứa từ khóa
        if (student.getName().find(name) != string::npos) {
            result.push_back(student);
        }
    }
    return result;
}

// 3. Tìm kiếm sinh viên theo Tuổi
vector<Student> getStudentsByAge(int age, const vector<Student>& list) {
    vector<Student> result;
    int currentYear = 2026; // Giả định năm hiện tại
    for (const auto& student : list) {
        int studentAge = currentYear - student.getBirthdate().year;
        if (studentAge == age) {
            result.push_back(student);
        }
    }
    return result;
}

// 4. Thống kê / Lấy danh sách sinh viên theo Năm sinh (2000, 2001, 2005, 2006, v.v.)
vector<Student> getStudentsByYear(int year, const vector<Student>& list) {
    vector<Student> result;
    for (const auto& student : list) {
        if (student.getBirthdate().year == year) {
            result.push_back(student);
        }
    }
    return result;
}

// 5. Thống kê / Lấy danh sách sinh viên theo Tỉnh hoặc Tên đường/Địa chỉ
vector<Student> getStudentsByAddress(string address, const vector<Student>& list) {
    vector<Student> result;
    for (const auto& student : list) {
        if (student.getAddress().find(address) != string::npos) {
            result.push_back(student);
        }
    }
    return result;
}

// =================================================================
// 4. HÀM HIỂN THỊ (HÀM BỔ TRỢ ĐỂ IN KẾT QUẢ OUT CONSOLE)
// =================================================================
void display(const vector<Student>& list) {
    if (list.empty()) {
        cout << "   --> [Khong tim thay sinh vien nao phu hop!]" << endl;
        return;
    }
    cout << "----------------------------------------------------------------------------" << endl;
    cout << left 
         << setw(22) << "Ho va Ten" 
         << setw(30) << "Dia Chi" 
         << setw(15) << "Ngay Sinh" 
         << setw(15) << "So CCCD" << endl;
    cout << "----------------------------------------------------------------------------" << endl;
    
    // Duyệt mảng bằng chỉ số index
    for (size_t i = 0; i < list.size(); i++) {
        list[i].printStudentInfo();
    }
    cout << "----------------------------------------------------------------------------" << endl;
    cout << "Tong so lượng: " << list.size() << " sinh vien." << endl;
}

